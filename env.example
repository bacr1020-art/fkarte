# إعدادات فِكرة — انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة.
NODE_ENV=development
# 127.0.0.1 = الجهاز نفسه فقط. استخدم 0.0.0.0 للوصول من أجهزة الشبكة.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/fikra.db
SESSION_TTL_DAYS=30
# اجعلها true عند التشغيل خلف HTTPS (إنتاج).
COOKIE_SECURE=false
MAX_BODY_MB=16

# ===== Google Gemini (الذكاء الاصطناعي) =====
# ضع مفتاحك هنا في ملف .env فقط (ملف .env مستثنى من Git). لا تضعه في أي مكان آخر.
GEMINI_API_KEY=
# اسم النموذج قابل للتغيير؛ راجع https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# حدود الاستخدام (مناسبة للطبقة المجانية)
AI_PER_MINUTE=5
AI_DAILY_LIMIT=100
AI_TIMEOUT_MS=40000
AI_MAX_INPUT_CHARS=6000
AI_MAX_MAP_NODES=80
AI_MAX_EXPAND_NODES=30
